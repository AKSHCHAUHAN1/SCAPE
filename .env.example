# ========================
# SCAPE — Environment Variables
# ========================
# Copy this file to .env and fill in values.
# NEVER commit .env to version control.

# ---- General ----
NODE_ENV=development

# ---- PostgreSQL ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=scape
POSTGRES_USER=scape_user
POSTGRES_PASSWORD=changeme

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- JWT (production requires an RS256 PEM key pair; development generates one automatically) ----
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ---- AWS ----
AWS_REGION=ap-south-1
AWS_ACCOUNT_ID=
AWS_PROVISIONING_ROLE_ARN=
AWS_COST_EXPLORER_ROLE_ARN=

# ---- Terraform ----
TF_STATE_BUCKET=scape-tf-state
TF_LOCK_TABLE=scape-tf-locks

# ---- GitHub App ----
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_INSTALLATION_ID=
GITHUB_REPOSITORY_OWNER=
GITHUB_TEMPLATE_OWNER=
GITHUB_NODEJS_API_TEMPLATE_REPO=
GITHUB_STATIC_FRONTEND_TEMPLATE_REPO=

# ---- Server ----
SERVER_PORT=3000
CORS_ORIGIN=http://localhost:5173

# ---- Client ----
VITE_API_URL=http://localhost:3000
