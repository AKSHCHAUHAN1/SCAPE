# SCAPE Server Environment
NODE_ENV=development

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=scape
POSTGRES_USER=scape_user
POSTGRES_PASSWORD=changeme

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT (development generates an ephemeral RS256 pair; production must supply both PEM keys)
# Encode line breaks as \n when placing PEM values on one line.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Server
PORT=3000
CORS_ORIGIN=http://localhost:5173

# AWS control-plane and Terraform state region. Service region is selected in the wizard.
AWS_REGION=ap-south-1
AWS_ACCOUNT_ID=
AWS_PROVISIONING_ROLE_ARN=
AWS_COST_EXPLORER_ROLE_ARN=

# Terraform
TF_STATE_BUCKET=scape-tf-state
TF_LOCK_TABLE=scape-tf-locks

# GitHub App
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_INSTALLATION_ID=
GITHUB_REPOSITORY_OWNER=
GITHUB_TEMPLATE_OWNER=
GITHUB_NODEJS_API_TEMPLATE_REPO=
GITHUB_PYTHON_API_TEMPLATE_REPO=
GITHUB_CONTAINER_API_TEMPLATE_REPO=
GITHUB_STATIC_FRONTEND_TEMPLATE_REPO=
